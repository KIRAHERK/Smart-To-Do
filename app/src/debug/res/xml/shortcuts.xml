<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: "Talk" opens the app already listening. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutId="talk"
        android:shortcutLongLabel="@string/shortcut_talk_long"
        android:shortcutShortLabel="@string/talk">
        <intent
            android:action="io.github.kiraherk.smarttodo.TALK"
            android:targetClass="io.github.kiraherk.smarttodo.MainActivity"
            android:targetPackage="io.github.kiraherk.smarttodo.debug" />
    </shortcut>
</shortcuts>
