<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google backup and phone-to-phone transfer. The API key is not included. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="backups/" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="ui_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="backups/" />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="ui_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
